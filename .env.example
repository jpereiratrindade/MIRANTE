# ==============================================================================
# MIRANTE — Configuração de Ambiente (.env)
# ==============================================================================
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente:
# cp .env.example .env
#
# OBS: O arquivo .env é ignorado pelo Git para proteger credenciais.
# ==============================================================================

# ------------------------------------------------------------------------------
# Servidor HTTP & Rede
# ------------------------------------------------------------------------------
MIRANTE_HOST=0.0.0.0
MIRANTE_PORT=8088
MIRANTE_DB_PATH=mirante.sqlite3

# ------------------------------------------------------------------------------
# Autenticação SisTer & Disparo de E-mail (Código de Entrada OTP)
# ------------------------------------------------------------------------------
# Se os dados de SMTP estiverem preenchidos, o MIRANTE enviará o código de 6 dígitos
# via e-mail real usando TLS/STARTTLS.
# Se deixado em branco, opera em modo DEV/LOCAL (código exibido no console e retorno JSON).

MIRANTE_SMTP_HOST=smtp.gmail.com
MIRANTE_SMTP_PORT=587
MIRANTE_SMTP_USER=notificacoes@labeco.invalid
MIRANTE_SMTP_PASS=sua_senha_de_aplicativo_aqui
MIRANTE_SMTP_FROM="MIRANTE SisTer <notificacoes@labeco.invalid>"

# ------------------------------------------------------------------------------
# Token de API Mestre (Opcional / Fallback para Automações e CI)
# ------------------------------------------------------------------------------
# Usado como chave de contingência para scripts administrativos e integrações legadas.
MIRANTE_API_TOKEN=

# ------------------------------------------------------------------------------
# Motor de Linguagem Local (Ollama)
# ------------------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
